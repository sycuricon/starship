# SoC configuration

import os.path as path
from ptm import environ as env

STARSHIP_CORE   = param.get("core", "Rocket")
STARSHIP_FREQ   = param.get("freq", "100")
STARSHIP_TB     = param.get("tb", "starship.asic.TestHarness")
STARSHIP_DUT    = param.get("dut", "starship.asic.StarshipSimTop")
STARSHIP_CONFIG = param.get("config", "starship.asic.StarshipSimMiniConfig")

if STARSHIP_CORE == "CVA6":
    assert ${CVA6_HOME} is not None, "$CVA6_HOME must point to CVA6 repository"
elif STARSHIP_CORE == "XiangShan":
    assert ${XS_HOME} is not None, "$XS_HOME must point to XiangShan repository"

SIMULATION_MODE = param.get("sim", "normal")
SIMULATION_INPUT  = param.get("input", STARSHIP_BUILD / "dummytest.hex")
SIMULATION_LABEL  = param.get("label", path.splitext(path.basename(SIMULATION_INPUT))[0])

env["JAVA_TOOL_OPTIONS"] = "-Xmx10G -Xss8M"
